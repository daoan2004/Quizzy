@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="section-shell account-status-shell">
    <div class="glass-panel account-status-card text-center">
        <div class="account-status-icon danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h1>Something went wrong</h1>
        <p>An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="glass-button account-status-action">
            <i class="bi bi-house-door"></i> Back to home
        </a>
    </div>
</section>
