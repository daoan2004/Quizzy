@* Login.cshtml — Partial view, KHÔNG dùng <html>/<head>/<body> riêng *@
@using ProjectBase.Models

<div class="container">
    <div class="modal fade" tabindex="-1" id="loginModal" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content auth-modal">
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close login dialog">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
                <div id="loginErrorMessage" class="alert alert-danger" style="display:none;">
                    Invalid email or password. Please try again.
                </div>
                <div class="modal-title text-center w-100"><i class="bi bi-stars"></i> Quizly</div>
                <div class="modal-body">
                    <form id="loginForm" asp-action="Login" asp-controller="Account">
                        <div class="form-group d-flex justify-content-center">
                            <input class="form-control" type="email" placeholder="Email address" id="inputUserNameLogin" autocomplete="email" aria-label="Email address" />
                        </div>
                        <div class="form-group d-flex justify-content-center">
                            <input class="form-control" type="password" placeholder="Password" id="inputPasswordLogin" autocomplete="current-password" aria-label="Password" />
                        </div>
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary btn-login mb-2" id="loginModelBtn"><i class="bi bi-box-arrow-in-right"></i> Login</button>
                        </div>
                        <div class="form-group text-center">
                            <a href="/Account/ResetPasswordRequest" class="btn btn-link">Reset Password</a>
                        </div>
                        <div class="form-group text-center">
                            <button type="button" class="btn btn-secondary" id="registerBtnLogin"><i class="bi bi-person-plus"></i> Register</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var formData = {};
        var isSubmitting = false;
        $('#loginForm').submit(function (event) {
            event.preventDefault();
            var email = $('#inputUserNameLogin').val();
            var password = $('#inputPasswordLogin').val();
            $('#loginErrorMessage').hide();

            if (!email || !password) {
                $('#loginErrorMessage').text('Please enter both email and password.').show();
                return;
            }

            formData = { email: email, password: password };
            isSubmitting = true;

            $.ajax({
                url: '/Account/Login',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    if (response.success) {
                        $('#buttonContainer').hide();
                        $('#userMenu').show();
                        location.reload();
                    } else {
                        $('#loginErrorMessage').text(response.message).show();
                    }
                },
                error: function (xhr, status, error) {
                    $('#loginErrorMessage').text('An error occurred while logging in.').show();
                },
                complete: function () {
                    isSubmitting = false;
                }
            });
        });

        $('#registerBtnLogin').click(function () {
            window.QuizlyUi?.hideModal('#loginModal');
            window.QuizlyUi?.showModal('#registerModal');
        });
    });
</script>
