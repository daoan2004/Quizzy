<div class="latestPost-wrapper">
    <h1>Latest Posts</h1>
    <div class="grid-container">
    @foreach (var item in Model.LatestPosts)
    {
        <div class="latestPost-item glass-card js-tilt-card">
            
            <div class="post-details">
                <a asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID" style="text-decoration: none; color: inherit;">@item.title</a>
                <div>
                    <span class="author author-user-@item.userID" data-user-id="@item.userID"><i class="bi bi-person"></i></span> <br/>
                    <span class="date"><i class="bi bi-calendar3"></i> @item.updatedAt.ToString("yyyy-MM-dd")</span>
                </div>
				
            </div>  
            <div class="latestPost-thumbnail">
            <img src="~/picture/Carousel/@item.blog_picture" alt="@item.title">
            </div>
        </div>
    }
		
	</div>
    <div class="contact-wrapper"><a class="contact" href="https://fpt.edu.vn/">Contact us <i class="bi bi-share"></i></a></div>
</div>

