@model ProjectBase.Models.SubjectViewModel

<div id="subjectPopupContent" class="subject-register-modal">
    @foreach (var subject in Model.Subjects)
    {
        <div class="register-modal-hero">
            <img src="~/picture/Subject/@subject.thumbnail_color" alt="@subject.title" loading="lazy" decoding="async">
            <div class="register-modal-hero-content">
                <span><i class="bi bi-patch-check-fill"></i> Subject Registration</span>
                <h2>@subject.title</h2>
            </div>
        </div>

        <div class="register-modal-body">
            <div class="subject_categories register-modal-tags">
                @foreach (var subjectCategory in subject.Subject_Category)
                {
                    <span>@subjectCategory.Category.title</span>
                }
            </div>

            <p class="brief-text register-modal-brief">@subject.brief_info</p>

            <form method="post" action="/SubjectRegister/Register" class="register-modal-form">
                <input type="hidden" name="subjectId" value="@subject.ID" />
                <input type="hidden" name="userId" id="userId" value="" />

                <div class="package_wrapper_register">
                    @foreach (var pricePackage in subject.Price_package)
                    {
                        var packageLabel = pricePackage.PackageType == 1
                            ? "3 Months"
                            : pricePackage.PackageType == 2
                                ? "6 Months"
                                : "12 Months";

                        <label class="price_option" for="package_@pricePackage.PackageType">
                            <input type="hidden" name="packageId" value="@pricePackage.ID" />
                            <input type="radio" id="package_@pricePackage.PackageType" name="selectedPackage" value="@pricePackage.PackageType"
                                   @(Model.UserRegistration != null && Model.UserRegistration.PricePackage_ID == pricePackage.ID ? "checked" : "") />

                            <span class="price-option-main">
                                <span class="package-text">@packageLabel package</span>
                                <span class="price-option-note">Full access for this subject</span>
                            </span>

                            <span class="price_wrapper">
                                <span class="list-price">@pricePackage.ListPrice USD</span>
                                <span class="sale-price">@pricePackage.SalePrice USD</span>
                            </span>
                        </label>
                    }
                </div>

                @if (Model.UserID == 0)
                {
                    <p class="noti_regis"><i class="bi bi-info-circle"></i> You need to be logged in to register.</p>
                    <div class="center-button">
                        <button id="login_from_subject_popup" type="button">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </button>
                    </div>
                }
                else if (Model.UserRegistration != null)
                {
                    <p class="noti"><i class="bi bi-check-circle"></i> You already registered for this subject.</p>
                    <div class="center-button">
                        <button id="register_button_popup_2" type="submit">
                            Edit Registration
                        </button>
                    </div>
                }
                else
                {
                    <div class="center-button">
                        <button id="register_button_popup_1" type="submit">
                            Register Now <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                }
            </form>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        function GetUserDetails() {
            $.ajax({
                url: '/Account/GetUserDetails',
                method: 'GET',
                success: function (response) {
                    if (response.success) {
                        var userId = response.userDetails.userID;
                        $('input[name="userId"]').val(userId);
                    }
                }
            });
        }
        GetUserDetails();

        $('#login_from_subject_popup').on('click', function () {
            window.QuizlyUi?.hideModal('#subjectPopup');
            window.QuizlyUi?.showModal('#loginModal');
        });
    });
</script>
