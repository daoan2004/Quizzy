<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Quizly helps learners browse subjects, read learning posts, practice quizzes, and review progress.")" />
    <title>@ViewData["Title"] - Quizly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/0e77a7e145.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="false" />
    <link rel="stylesheet" href="~/css/header-footer.css" />
    <link rel="stylesheet" href="~/css/shared.css" />
    <link rel="stylesheet" href="~/css/Popup.css" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
</head>

<body id="bootstrap-overrides">
    <header class="header">

        <nav class="navbar navbar-expand-md navbar-toggleable-md">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Quizly</a>

                @* Hamburger button (hiển thị trên mobile) *@
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <form id="searchFormHome" asp-controller="Subjects" asp-action="ShowSearchResults" method="post" class="d-flex mx-2">
                        <input type="text" id="searchInput" name="searchPhrase" placeholder="Search Subjects here" class="search-input-nav">
                    </form>
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item text-dark">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Blogs" asp-action="Index">Blogs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Subjects" asp-action="Index">Subjects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">About us</a>
                        </li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="action" id="userMenu">
                            <button class="profile" type="button" aria-label="Open user menu">
                                <i class="fa-solid fa-user"></i>
                            </button>
                            <div class="menu">
                                <ul>
                                    <li>
                                        <a href="#" id="profileBtn">User profile</a>
                                    </li>
                                    <li>
                                        <a href="#" id="changePasswordBtn">Change Password</a>
                                    </li>
                                    @if (User.IsInRole("Marketing"))
                                    {
                                        <li>
                                            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                        </li>
                                    }
                                    <li>
                                        <a asp-controller="Practice" asp-action="Index">Practice List</a>
                                    </li>
                                    <li>
                                        <a asp-controller="MyRegistrations" asp-action="Index">My Registrations</a>
                                    </li>
                                    <li>
                                        <a asp-action="Logout" asp-controller="Account">Logout</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="buttonContainer">
                            <button class="register" type="button" id="registerBtn"><i class="bi bi-person-plus"></i> Register</button>
                            <button class="login" type="button" id="loginBtn"><i class="bi bi-box-arrow-in-right"></i> Login</button>
                        </div>
                    }
                </div>
            </div>
        </nav>


    </header>
    <div class="page-wrapper">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-logo">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="logo">Quizly</a>
        </div>
        <nav class="footer-navbar">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a asp-area="" asp-controller="Blogs" asp-action="Index">Blogs</a>
            <a asp-area="" asp-controller="Subjects" asp-action="Index">Subjects</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">About us</a>
        </nav>

    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("~/Views/Shared/Login.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Register.cshtml", new RegisterModel())
    @await Html.PartialAsync("~/Views/User/ChangePassword.cshtml", new ChangePasswordModel())
    @await Html.PartialAsync("~/Views/User/Profile.cshtml")
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
