<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Quizly helps learners browse subjects, read learning posts, practice quizzes, and review progress.")" />
    <title>@ViewData["Title"] - Quizly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header-footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Popup.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body id="bootstrap-overrides">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header class="header">

        <nav class="navbar navbar-expand-lg navbar-toggleable-lg" aria-label="Main navigation">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Quizly home">
                    <span class="brand-mark" aria-hidden="true"><i class="bi bi-check2"></i></span>
                    <span>Quizly</span>
                </a>

                @* Hamburger button (hiển thị trên mobile) *@
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Subjects" ? "active" : "")" asp-area="" asp-controller="Subjects" asp-action="Index">Subjects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Blogs" ? "active" : "")" asp-area="" asp-controller="Blogs" asp-action="Index">Blogs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">About</a>
                        </li>
                    </ul>

                    <div class="navbar-actions">
                        <form id="searchFormHome" asp-controller="Subjects" asp-action="ShowSearchResults" method="post">
                            <label class="nav-search" for="searchInput">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" id="searchInput" name="searchPhrase" placeholder="Search subjects" class="search-input-nav" autocomplete="off">
                                <span class="search-hint" aria-hidden="true">/</span>
                            </label>
                        </form>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="action" id="userMenu">
                            <button class="profile" type="button" aria-label="Open user menu" aria-expanded="false" aria-haspopup="true">
                                <i class="bi bi-person"></i>
                                <span>Account</span>
                                <i class="bi bi-chevron-down profile-chevron" aria-hidden="true"></i>
                            </button>
                            <div class="menu">
                                <ul>
                                    <li>
                                        <a href="#" id="profileBtn">User profile</a>
                                    </li>
                                    <li>
                                        <a href="#" id="changePasswordBtn">Change Password</a>
                                    </li>
                                    @if (User.IsInRole("Marketing"))
                                    {
                                        <li>
                                            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                        </li>
                                    }
                                    <li>
                                        <a asp-controller="Practice" asp-action="Index">Practice List</a>
                                    </li>
                                    <li>
                                        <a asp-controller="MyRegistrations" asp-action="Index">My Registrations</a>
                                    </li>
                                    <li>
                                        <a asp-action="Logout" asp-controller="Account">Logout</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="buttonContainer">
                            <button class="register" type="button" id="registerBtn">Create account</button>
                            <button class="login" type="button" id="loginBtn">Log in <i class="bi bi-arrow-right"></i></button>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </nav>


    </header>
    <div class="page-wrapper">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="footer-logo logo">Quizly</a>
                <p>Browse subjects, practice with focus, and keep your learning progress visible.</p>
            </div>

            <nav class="footer-column" aria-label="Footer navigation">
                <h2>Explore</h2>
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Blogs" asp-action="Index">Blogs</a>
                <a asp-area="" asp-controller="Subjects" asp-action="Index">Subjects</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">About us</a>
            </nav>

            <nav class="footer-column" aria-label="Learning navigation">
                <h2>Learn</h2>
                <a asp-area="" asp-controller="Practice" asp-action="Index">Practice list</a>
                <a asp-area="" asp-controller="SimulationExam" asp-action="Index">Simulation exam</a>
                <a asp-area="" asp-controller="MyRegistrations" asp-action="Index">My registrations</a>
                <a href="https://fpt.edu.vn/">Contact us</a>
            </nav>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year Quizly</span>
            <span>Built for steady study sessions.</span>
        </div>
    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/swiper/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("~/Views/Shared/Login.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Register.cshtml", new RegisterModel())
    @await Html.PartialAsync("~/Views/User/ChangePassword.cshtml", new ChangePasswordModel())
    @await Html.PartialAsync("~/Views/User/Profile.cshtml")
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
