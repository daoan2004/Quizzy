 @* Register.cshtml *@
@model ProjectBase.Models.RegisterModel
    <div class="container">
        <div class="modal fade" tabindex="-1" id="registerModal" role="dialog" aria-modal="true" aria-labelledby="registerModalTitle" data-keyboard="false" data-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content auth-modal">
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close registration dialog">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                    <div id="registerSuccessMessage" class="alert alert-success" role="status" aria-live="polite" style="display:none;">
                        Registration successful. Please check email to verify your account!
                    </div>
                    <div id="registerErrorMessage" class="alert alert-danger" role="alert" aria-live="assertive" style="display:none;">
                        Registration failed. Please try again.
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <form id="registerForm" asp-action="Register" asp-controller="Account">
                            <div class="row">
                                
                                <div class="col-md-8">
                                    <div id="registerModalTitle" class="modal-titleLeft"><i class="bi bi-person-plus"></i> Register</div>
                                    <div class="formRegister-groupContent">
                                        <input asp-for="fullname" type="text" placeholder="Enter fullname" id="inputFullName" aria-label="Full name" />
                                    </div>
                                    <div class="formRegister-groupContent">
                                        <input asp-for="Phone" type="text" placeholder="Phone number" id="inputPhoneNumber" aria-label="Phone number" />
                                    </div>
                                    <div class="formRegister-groupContent">
                                        <input asp-for="email" type="email" placeholder="Email" id="inputEmail" aria-label="Email address" />
                                    </div>
                                    <div class="formRegister-groupContent">
                                        <input asp-for="password" type="password" placeholder="Password" id="inputPasswordRegister" aria-label="Password" />
                                    </div>
                                    <div class="formRegister-groupContent">
                                        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" id="inputConfirmPassword" aria-label="Confirm password" />
                                    </div>
                                    <div class="formRegister-group" id="genderContainer">
                                        <div class="title">
                                            <label>Gender?</label>
                                        </div>
                                        <br>
                                        <div class="genderOptions">
                                            <div class="genderOption">
                                                <input asp-for="gender" type="radio" id="male" name="gender" value="true">
                                                <label for="male">Male</label>
                                            </div>
                                            <div class="genderOption">
                                                <input asp-for="gender" type="radio" id="female" name="gender" value="false">
                                                <label for="female">Female</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 right">
                                        <div class="modal-titleRight"><i class="bi bi-stars"></i> Quizly</div>
                                        <div class="form-group">
                                        <button type="submit" class="btn btn-secondary btn-register" id="registerModelBtn"><i class="bi bi-check2-circle"></i> Register</button>
                                        <div class="modal-titleRightOr">Already have an account?</div>
                                        <button type="button" class="btn btn-secondary btn-login" id="loginBtnRegister"><i class="bi bi-box-arrow-in-right"></i> Login</button>
                                        </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <script src="~/js/AccountRegister.js" asp-append-version="true"></script>



