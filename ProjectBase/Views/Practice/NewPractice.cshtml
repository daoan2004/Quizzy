@{
    ViewData["Title"] = "NewPractice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Practice.css" asp-append-version="true" />
}
    <section class="practice-page new-practice-page" id="content-grapper">
        <div class="practice-shell glass-panel" data-aos="fade-up">
            <!--New Practice header start-->
			<div class="newpractice-header"> 			
				<div class="page-name">
					<h3><i class="bi bi-plus-circle"></i> New Practice Form</h3>
			    </div>
				<div class="simulation-button">
                    <button type="button" class="header-button" onclick="location.href='@Url.Action("Index", "SimulationExam")'"><i class="bi bi-clipboard2-check"></i> Simulation Exam</button>
				</div>			
			</div>
            <!--New Practice header end-->
            <!--Subject scroll list start-->
            
                <div class="scroll-list-wrapper">
                
				</div>
            
            <!--Subject scroll list end-->
            <!--Input infomation start-->
            <div class="input-area glass-card" data-aos="fade-up" data-aos-delay="100">
                <div class="form-group">
                    <label for="test-name">Test Name: </label>
                    <input class="inputform" type="text" id="test-name" placeholder="Exam Name " required="required">
                    <div class="alerttestname" role="alert" aria-live="polite"></div>
                </div>
                <div class="form-group">
                    <label for="no-of-questions">No of Question: </label>
                    <input class="inputform" type="number" id="no-of-questions" placeholder="Number of question" required="required">
                    <div class="alertnoofquest" role="alert" aria-live="polite"></div>
                </div>
                <div class="form-group">
                    <label for="Quest-group">Question Group</label>
                    <form>
                        <select id="Quest-group">
                            <option value="0">All</option>
                            <option value="Yes/No Question">Yes/No Question</option>
                            <option value="Choose one">Choose one</option>
                            <option value="Multiple choice">Multiple choice</option>
                            <option value="Essays question">Essays question</option>
                        </select>
                    </form>
                </div>
                <div class="form-topic">
                    <label for="select-topic">Subject topic:</label>
                    <form>
                        <select id="select-topic">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">Choose 3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                    </form>
                </div>
                <div class="difficulty-level">
                    <label>Difficulty Level: </label>
                    <div class="difficulty-options">
                        <input type="radio" id="easy" name="difficulty" value="1" checked>
                        <label for="easy">Easy (90% easy quiz, 10% medium quiz)</label><br>
                        <input type="radio" id="medium" name="difficulty" value="2">
                        <label for="medium">Medium (30% easy quiz, 70% medium quiz)</label><br>
                        <input type="radio" id="hard" name="difficulty" value="3">
                        <label for="hard">Hard (60% medium quiz, 40% hard quiz)</label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="test-duration">Test Duration: </label>
                    <input class="inputform" type="Number" id="test-duration" placeholder="Test duration (in minutes)" required="required">
                    <div class="alertduration" role="alert" aria-live="polite"></div>
                </div>
                <div class="bottom-button">
                <button type="button" class="submit-button">Practice</button>
                <div class="Back">
                <button type="button" class="header-button" onclick="window.history.back()"><i class="bi bi-arrow-left"></i> Back</button>
                </div>
                <div class="alertbottom" role="alert" aria-live="polite"></div>
            </div>
            <!--Input infomation end-->
        </div>
    </div>
    </section>

        @section Scripts {
            <script src="~/js/NewPractice.js" asp-append-version="true"></script>
        }
