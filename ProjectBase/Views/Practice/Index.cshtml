@{
    ViewData["Title"] = "Practice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Practice.css" asp-append-version="true" />
}

<section class="practice-page" id="content-grapper">
        <div class="practice-shell glass-panel" data-aos="fade-up">
            <!--Practice list header-->
            <div class="header-wrapper">
               <div class="flex">
                    <div class="page-name">
                    <h3><i class="bi bi-journal-check"></i> Practice List</h3>
                </div>
                <div class="dropdown-bar">
                    <form>
                        <select id="subjectFilter" aria-label="Filter by subject">
                            <option value="">All Subjects</option>
                        </select>
                    </form>
                </div>
                <div class="dropdown-bar">
                    <form>
                        <select id="levelFilter" aria-label="Filter by difficulty">
                            <option value="">All level</option>
                            
                        </select>
                    </form>
                </div>
			    </div>
                <div class="flex" >
                <div class="new-practice">
                        <button type="button" class="header-button" onclick="location.href='@Url.Action("NewPractice", "Practice")'"><i class="bi bi-plus-circle"></i> New Practice</button>
                </div>
                <div class="simulation-exam ">
                        <button type="button" class="header-button" onclick="location.href='@Url.Action("Index", "SimulationExam")'"><i class="bi bi-clipboard2-check"></i> Simulation Exam</button>
                </div>
				</div>
            </div>
            <!--Practice list Table wrapper-->       
            <div class="Table-wrapper glass-panel" data-aos="fade-up" data-aos-delay="100">
                <table>
                    
					<thead class="thead">
						<tr>
							<th>Subject Name</th>
							<th>Practice Name</th>
                            <th>Questions </th>
							<th>Correct Rate</th>
							<th>Dificulity</th>
							<th>Date Taken</th>
							<th></th>
						</tr>
					</thead>
                   
                    <tbody id="PracticeList" aria-live="polite">
                        
                    </tbody>
				
                </table>
                
                <nav id="pagination" aria-label="Practice pages">
                    
                </nav>
            </div>		
        </div>
    </section>

@section Scripts {
        <script src="~/js/PracticeList.js" asp-append-version="true"></script>
}


    
