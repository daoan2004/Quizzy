@model IEnumerable<ProjectBase.Models.SubjectsModel>

@{
    ViewData["Title"] = "MyRegistrations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/SubjectDetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/SubjectRegister.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MyRegistrations.css" asp-append-version="true" />
}
    <section class="registrations-page" id="content-wrapper">
        <div class="my-registrations-shell" id="mainContent">
            <div class="mainContainer glass-panel">
                <div id="notification" role="status" aria-live="polite" style="display: none;"></div>
                <div class="header-wrapper">
                    <div class="flex">
                        <div class="page-name">
                            <h3><i class="bi bi-journal-check"></i> My Registrations</h3>
                        </div>
                    </div>
                </div>

                <div class="registrations-hero">
                    <div>
                        <span class="registrations-eyebrow">Learning dashboard</span>
                        <h1>My learning packages</h1>
                        <p>Track active packages, pending payments, and jump back into practice without hunting through a wide table.</p>
                    </div>
                    <div class="registrations-summary" aria-label="Registration summary" aria-live="polite">
                        <div>
                            <strong id="summaryTotal">0</strong>
                            <span>Total</span>
                        </div>
                        <div>
                            <strong id="summaryActive">0</strong>
                            <span>Active</span>
                        </div>
                        <div>
                            <strong id="summaryPending">0</strong>
                            <span>Pending</span>
                        </div>
                    </div>
                </div>

                <div class="registrations-toolbar">
                    <label class="registrations-filter">
                        <span>Subject</span>
                        <select id="subjectFilter">
                            <option value="">All subjects</option>
                        </select>
                    </label>
                    <label class="registrations-filter">
                        <span>Status</span>
                        <select id="levelStatus">
                            <option value="">All statuses</option>
                            <option value="Registrated">Registrated</option>
                            <option value="Submitted">Submitted</option>
                        </select>
                    </label>
                    <button type="button" id="applyRegistrationFilters" class="bttn btn-filter">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>

                <div class="registrations-list-shell">
                    <div id="myRegistrationsList" class="registrations-list" aria-live="polite"></div>
                    <nav id="pagination" class="registrations-pagination" aria-label="Registration pages"></nav>
                </div>
            </div>
            <!-- Sidebar area -->
            <div class="sidebar-container">
                <div class="sidebar_subject_category">
                    <div class="sidebar-box">
                        <partial name="_SubjectSideBarPartial" />
                    </div>
                </div>
                <div class="sidebar_subject_featured">
                    <div class="sidebar-box">
                        <partial name="_SubjectFeaturedPartial" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal xác nhận hủy đăng ký -->
    <div id="myModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="cancelModalTitle" aria-hidden="true">
        <div class="modal-content confirm-modal-content">
            <i class="bi bi-exclamation-circle"></i>
            <p id="cancelModalTitle">Are you sure you want to unenroll from this course?</p>
            <div class="btnConfirm">
                <button type="button" id="confirmCancel" class="bttn btn-yes">Yes</button>
                <button type="button" id="closeModal" class="bttn btn-no">No</button>
            </div>
        </div>
    </div>

    <!-- Modal xác nhận thanh toán -->
    <div id="payModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="payModalTitle" aria-hidden="true">
        <div class="modal-content confirm-modal-content">
            <i class="bi bi-credit-card"></i>
            <p id="payModalTitle">Are you sure you want to pay for this package?</p>
            <div class="btnConfirm">
                <button type="button" id="confirmPay" class="bttn btn-yes">Yes</button>
                <button type="button" id="closePayModal" class="bttn btn-no">No</button>
            </div>
        </div>
    </div>

    <div class="modal fade" id="subjectPopup" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="subjectPopupLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div id="popup_register" class="modal-content">
                <div class="modal-body" id="subjectPopupContent">
                    <!-- Partial view content will be loaded here -->
                </div>
            </div>
        </div>
    </div>



    @section Scripts {
        <script src="~/js/SubjectsScript.js" asp-append-version="true"></script>
        <script src="~/js/MyRegistrations.js" asp-append-version="true"></script>
    }



