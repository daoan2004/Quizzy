@{
    ViewData["Title"] = "Quiz Handle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model ProjectBase.Models.PracticeModel
@section Styles {
    <link rel="stylesheet" href="~/css/Quiz.css" asp-append-version="true" />
}
    <section class="quiz-page"
             id="content-grapper"
             data-user-id="@Model.UserID"
             data-practice-id="@Model.ID"
             data-attempt-ends-at="@ViewData["AttemptEndsAtUtc"]">
        <div class="quiz-shell glass-panel" data-aos="fade-up">
            <div class="top-detail glass-card">
                <h3 class="Practice-Title"><i class="bi bi-lightning-charge"></i> @ViewData["SubjectTitle"] - @ViewData["QuizTitle"]</h3>
                <div class="Practice_Detail">
                    <h3><i class="bi bi-ui-checks"></i> Type: @ViewData["Type"]</h3>
                    <h3><i class="bi bi-question-circle"></i> Question: @ViewData["Number_quiz"]</h3>
                    <h3><i class="bi bi-bar-chart"></i> Difficulty: @ViewData["Level"]</h3>
                </div>            
			</div>
            <div class="quiz-workspace">
                <div class="main-detail glass-panel" data-aos="fade-up" data-aos-delay="100">
                    <div id="quizFeedback" class="quiz-feedback" role="alert" aria-live="assertive" hidden></div>
                    <div class="quiz-item">
                        <div class="quiz-side">
                            <p class="question-index">Question No 1</p>
                            <p class="status">status</p>
                            <p class="ismark">mark</p>
                            <div class="navigation-button">
                                <button type="button" class="prev-button"><i class="bi bi-arrow-left"></i> Previous</button>
                                <button type="button" class="next-button">Next <i class="bi bi-arrow-right"></i></button>
                            </div>
                        </div>
                        <div class="quiz-main">
                            <div class="quiz-title">
                                
                            </div>
                            <div class="quiz-answer">
                                
                            </div>
                        </div>
                    </div>
                    
                </div>
                <div class="Practice-Progress glass-panel" data-aos="fade-left" data-aos-delay="150">
                    <div class="timer" role="timer" aria-live="polite">
                       
                    </div>
                    <div class="P-bar">
                        <p><i class="bi bi-activity"></i> Progress</p><br/>
                        <div id="progress-bar-container">
                            <div id="progress-bar" role="progressbar" aria-label="Quiz progress" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                    </div>
                    <div class="quiz-navigation">
                        <h3><i class="bi bi-grid-3x3-gap"></i> Quiz navigation</h3>
                        <div class="quiz-number" id="quiz-number">

                        </div>
                        <button type="button" class="finish-attempt"><i class="bi bi-check-circle"></i> Finish attempt</button>
                    </div>
                   

                </div>
            </Div>
        </div>
        <!-- Pop-up div -->
    <div id="confirm-popup" class="popup">
        <div class="popup-content">
            <p>Are you sure you want to finish the attempt?</p>
            <button type="button" id="confirm-yes">Yes</button>
            <button type="button" id="confirm-no">No</button>
        </div>
    </div>
    </section>
@section Scripts {
    <script src="~/js/QuizHandle.js" asp-append-version="true"></script>

}
