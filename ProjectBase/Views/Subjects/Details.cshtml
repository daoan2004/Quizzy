@model IEnumerable<ProjectBase.Models.SubjectsModel>

@{
    ViewData["Title"] = "Subject Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SubjectDetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/SubjectRegister.css" asp-append-version="true" />
}

<section class="subject-detail-page" id="content-wrapper">
    <div class="subject-detail-shell">
        <main class="subject-detail-main glass-panel" data-aos="fade-up">
            @foreach (var subject in Model)
            {
                <article class="subject-detail-card glass-card">
                    <header class="subject-detail-hero">
                        <img src="~/picture/Subject/@subject.thumbnail_color" alt="@subject.title" loading="lazy" decoding="async">
                        <div class="subject-detail-hero-content">
                            <span><i class="bi bi-patch-check-fill"></i> Available Subject</span>
                            <h1>@subject.title</h1>
                        </div>
                    </header>

                    <div class="subject-detail-body">
                        <div class="subject_categories subject-detail-tags">
                            @foreach (var subjectCategory in subject.Subject_Category)
                            {
                                <span>@subjectCategory.Category.title</span>
                            }
                        </div>

                        <p class="brief-text subject-detail-brief">@subject.brief_info</p>

                        <section class="subject-description-card">
                            <h2><i class="bi bi-journal-text"></i> Subject Description</h2>
                            <p>@subject.Description</p>
                        </section>

                        @foreach (var pricePackage in subject.Price_package.Where(pp => pp.PackageType == 1))
                        {
                            <section class="subject-detail-package">
                                <div>
                                    <span class="subject-package-label">
                                        @(pricePackage.PackageType == 1 ? "1 Month" : pricePackage.PackageType + " Months") package
                                    </span>
                                    <div class="subject-package-price">
                                        <span class="list-price">@pricePackage.ListPrice USD</span>
                                        <span class="sale-price">@pricePackage.SalePrice USD</span>
                                    </div>
                                </div>

                                <a class="register_button register-button" data-subject-id="@subject.ID" href="#">
                                    Register Now <i class="bi bi-arrow-right"></i>
                                </a>
                            </section>
                        }
                    </div>
                </article>
            }

            <div id="back_button">
                <a asp-action="Index" asp-controller="Subjects">
                    <i class="bi bi-arrow-left"></i> Back to Subjects
                </a>
            </div>
        </main>

        <aside class="subject-detail-sidebar">
            <div class="sidebar-box subject-detail-sidebar-box" data-aos="fade-left">
                <partial name="_SubjectSideBarPartial" />
            </div>

            <div class="sidebar-box subject-detail-sidebar-box" data-aos="fade-left" data-aos-delay="100">
                <partial name="_SubjectFeaturedPartial" />
            </div>
        </aside>
    </div>
</section>

<div class="modal fade" id="subjectPopup" tabindex="-1" role="dialog" aria-labelledby="subjectPopupLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div id="popup_register" class="modal-content">
            <div class="modal-body" id="subjectPopupContent">
                <!-- Partial view content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<input type="hidden" name="userId" value="" />

@section Scripts {
    <script>
        $(document).ready(function () {
            function GetUserDetails() {
                $.ajax({
                    url: '/Account/GetUserDetails',
                    method: 'GET',
                    success: function (response) {
                        if (response.success) {
                            var userId = response.userDetails.userID;
                            $('input[name="userId"]').val(userId);
                        }
                    }
                });
            }
            GetUserDetails();
        });
    </script>
    <script src="~/js/SubjectsScript.js"></script>
    <script src="~/js/Register.js"></script>
}
