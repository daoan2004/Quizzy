@model QuizReviewViewModel

@{
    ViewData["Title"] = "Quiz Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/QuizReview.css" asp-append-version="true" />
}

    <div class="row" id="content-wrapper">
        <div class="container quiz-review-shell">
            <div class="main-wrapper">
                <div class="quiz_review_header glass-panel" data-aos="fade-up">
                    <h1 class="text_style"><i class="bi bi-clipboard-check"></i> Quiz Review</h1>
                    <button id="filter-correct" class="btn btn-primary"><i class="bi bi-filter-circle"></i> Show Correct Answers Only</button>
                    <div class="text_style">
                        <p><strong>Title:</strong> @Model.Practice?.title</p>
                        <p><strong>Taken Date:</strong> @Model.Practice?.taken_date</p>
                        <p><strong>Quiz Duration:</strong> @ViewBag.DurationFormatted</p>
                        <p><strong>Time Taken:</strong> @ViewBag.TimeTakenFormatted</p>
                        <p><strong>Number of Questions:</strong> @(Model.Practice?.number_quest ?? 0)</p>
                        <p><strong>Number of Correct Answers:</strong> @(Model.Practice?.number_correct ?? 0)</p>
                        <p><strong>Number of Wrong Answers:</strong> @((Model.Practice?.number_quest ?? 0) - (Model.Practice?.number_correct ?? 0))</p>
                        <p><strong>Percentage of Correct Answers:</strong> @(((Model.Practice?.number_quest ?? 0) > 0 ? ((Model.Practice?.number_correct ?? 0) / (double)(Model.Practice?.number_quest ?? 1)) * 100 : 0).ToString("F2"))%</p>
                        <p><strong>Status:</strong> @(Model.Practice?.Status == true ? "Completed" : "Incomplete")</p>              
                    </div>
                </div>

                <div class="quiz_review_question">
                    @if (Model.QuizReviews != null)
                    {

                        var reviews = Model.QuizReviews.OrderBy(q => q.QuizID).ToList();
                        int index = 1;

                        foreach (var quiz_review in reviews)
                        {
                            <div id="question-@quiz_review.QuizID" class="quiz_question glass-card" data-aos="fade-up">
                                <div class="quiz_bank" data-correct="@quiz_review.QuizBank.Qcorrect" data-answer="@quiz_review.QAnswer">
                                    <div class="quiz_title">
                                        <p class="text_style question_number"><strong>Question @index:</strong></p>
                                    </div>

                                    <p class="text_style">
                                        <strong>@Html.Raw(quiz_review.QuizBank.Title)</strong>
                                        @switch (quiz_review.QuizBank.GroupID)
                                        {
                                            case "1":
                                                <span>(Y/N Question)</span>
                                                break;
                                            case "2":
                                                <span>(Choose one answer)</span>
                                                break;
                                            case "3":
                                                <span>(Choose multiple answers)</span>
                                                break;
                                            case "4":
                                                <span>(Write answer)</span>
                                                break;
                                            default:
                                                <span>(Unknown question type)</span>
                                                break;
                                        }
                                    </p>

                                    <div class="question">
                                        @if (!string.IsNullOrEmpty(@quiz_review.QuizBank.QA))
                                        {
                                            @if (@quiz_review.QuizBank.Qcorrect.Contains("A"))
                                            {
                                                @if (@quiz_review.QAnswer.Contains("A"))
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>A:</strong> @quiz_review.QuizBank.QA <span><i class="bi bi-check-lg"></i></span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>A:</strong> @quiz_review.QuizBank.QA
                                                    </p>
                                                }
                                            }
                                            else if (@quiz_review.QAnswer.Contains("A"))
                                            {
                                                <p class="answer-review is-wrong">
                                                    <strong>A:</strong> @quiz_review.QuizBank.QA <span><i class="bi bi-x-lg"></i></span>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="answer-review">
                                                    <strong>A:</strong> @quiz_review.QuizBank.QA
                                                </p>
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(@quiz_review.QuizBank.QB))
                                        {
                                            @if (@quiz_review.QuizBank.Qcorrect.Contains("B"))
                                            {
                                                @if (@quiz_review.QAnswer.Contains("B"))
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>B:</strong> @quiz_review.QuizBank.QB <span><i class="bi bi-check-lg"></i></span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>B:</strong> @quiz_review.QuizBank.QB
                                                    </p>
                                                }
                                            }
                                            else if (@quiz_review.QAnswer.Contains("B"))
                                            {
                                                <p class="answer-review is-wrong">
                                                    <strong>B:</strong> @quiz_review.QuizBank.QB <span><i class="bi bi-x-lg"></i></span>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="answer-review">
                                                    <strong>B:</strong> @quiz_review.QuizBank.QB
                                                </p>
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(@quiz_review.QuizBank.QC))
                                        {
                                            @if (@quiz_review.QuizBank.Qcorrect.Contains("C"))
                                            {
                                                @if (@quiz_review.QAnswer.Contains("C"))
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>C:</strong> @quiz_review.QuizBank.QC <span><i class="bi bi-check-lg"></i></span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>C:</strong> @quiz_review.QuizBank.QC
                                                    </p>
                                                }
                                            }
                                            else if (@quiz_review.QAnswer.Contains("C"))
                                            {
                                                <p class="answer-review is-wrong">
                                                    <strong>C:</strong> @quiz_review.QuizBank.QC <span><i class="bi bi-x-lg"></i></span>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="answer-review">
                                                    <strong>C:</strong> @quiz_review.QuizBank.QC
                                                </p>
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(@quiz_review.QuizBank.QD))
                                        {
                                            @if (@quiz_review.QuizBank.Qcorrect.Contains("D"))
                                            {
                                                @if (@quiz_review.QAnswer.Contains("D"))
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>D:</strong> @quiz_review.QuizBank.QD <span><i class="bi bi-check-lg"></i></span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>D:</strong> @quiz_review.QuizBank.QD
                                                    </p>
                                                }
                                            }
                                            else if (@quiz_review.QAnswer.Contains("D"))
                                            {
                                                <p class="answer-review is-wrong">
                                                    <strong>D:</strong> @quiz_review.QuizBank.QD <span><i class="bi bi-x-lg"></i></span>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="answer-review">
                                                    <strong>D:</strong> @quiz_review.QuizBank.QD
                                                </p>
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(@quiz_review.QuizBank.QE))
                                        {
                                            @if (@quiz_review.QuizBank.Qcorrect.Contains("E"))
                                            {
                                                @if (@quiz_review.QAnswer.Contains("E"))
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>E:</strong> @quiz_review.QuizBank.QE <span><i class="bi bi-check-lg"></i></span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>E:</strong> @quiz_review.QuizBank.QE
                                                    </p>
                                                }
                                            }
                                            else if (@quiz_review.QAnswer.Contains("E"))
                                            {
                                                <p class="answer-review is-wrong">
                                                    <strong>E:</strong> @quiz_review.QuizBank.QE <span><i class="bi bi-x-lg"></i></span>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="answer-review">
                                                    <strong>E:</strong> @quiz_review.QuizBank.QE
                                                </p>
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(@quiz_review.QuizBank.QF))
                                        {
                                            @if (@quiz_review.QuizBank.Qcorrect.Contains("F"))
                                            {
                                                @if (@quiz_review.QAnswer.Contains("F"))
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>F:</strong> @quiz_review.QuizBank.QF <span><i class="bi bi-check-lg"></i></span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="answer-review is-correct">
                                                        <strong>F:</strong> @quiz_review.QuizBank.QF
                                                    </p>
                                                }
                                            }
                                            else if (@quiz_review.QAnswer.Contains("F"))
                                            {
                                                <p class="answer-review is-wrong">
                                                    <strong>F:</strong> @quiz_review.QuizBank.QF <span><i class="bi bi-x-lg"></i></span>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="answer-review">
                                                    <strong>F:</strong> @quiz_review.QuizBank.QF
                                                </p>
                                            }
                                        }
                                    </div>


                                    <p class="text_style"><strong>Your Answer:</strong> @quiz_review.QAnswer</p>
                                    <p class="text_style"><strong>Correct Answer:</strong> @quiz_review.QuizBank.Qcorrect</p>
                                </div>
                            </div>
                            index++;
                        }
                    }
                </div>
            </div>

            <div class="sidebar-container">
                <div class="sidebar-wrapper glass-panel" data-aos="fade-left">
                    <h1><strong>Quiz Navigation</strong></h1>
                    <ul class="sidebar-menu">
                        @if (Model.QuizReviews != null)
                        {
                            var reviews = Model.QuizReviews.OrderBy(q => q.QuizID).ToList();
                            int index = 1; // Initialize index to 1

                            foreach (var quiz_review in reviews)
                            {
                                
                                    <button class="sidebar-button" data-target="#question-@quiz_review.QuizID">
                                        @index
                                    </button>
                                
                                index++; // Increment index for each review
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.sidebar-button').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    const target = document.querySelector(button.dataset.target);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            let filterState = 0;
            const filterButton = document.getElementById('filter-correct');

            if (!filterButton) {
                return;
            }

            filterButton.addEventListener('click', function () {
                filterState = (filterState + 1) % 3;

                document.querySelectorAll('.quiz_question').forEach(function (quizReview) {
                    const quizBank = quizReview.querySelector('.quiz_bank');
                    const correctAnswers = (quizBank?.dataset.correct || '').trim();
                    const userAnswers = (quizBank?.dataset.answer || '').trim();

                    if (filterState === 0) {
                        quizReview.hidden = false;
                    } else if (filterState === 1) {
                        quizReview.hidden = correctAnswers !== userAnswers;
                    } else if (filterState === 2) {
                        quizReview.hidden = correctAnswers === userAnswers;
                    }
                });

                if (filterState === 0) {
                    filterButton.innerHTML = '<i class="bi bi-filter-circle"></i> Show Correct Answers Only';
                } else if (filterState === 1) {
                    filterButton.innerHTML = '<i class="bi bi-filter-circle"></i> Show Incorrect Answers Only';
                } else {
                    filterButton.innerHTML = '<i class="bi bi-filter-circle"></i> Show All Answers';
                }
            });
        });
    </script>


