@{
    ViewData["Title"] = "Verification Successful";
}

<section class="section-shell account-status-shell">
    <div class="glass-panel account-status-card text-center">
        <div class="account-status-icon success">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1>Verification Successful</h1>
        <p>Your account has been successfully verified. You can now log in.</p>
        <div class="account-status-actions">
            <button type="button" class="glass-button account-status-action" id="verificationLoginBtn">
                <i class="bi bi-box-arrow-in-right"></i> Log in
            </button>
            <a asp-controller="Subjects" asp-action="Index" class="glass-button account-status-action">
                Browse subjects
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $('#verificationLoginBtn').on('click', function () {
            window.QuizlyUi?.showModal('#loginModal');
        });
    </script>
}
