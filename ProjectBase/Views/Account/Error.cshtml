@{
    ViewData["Title"] = "Error";
}

<section class="section-shell account-status-shell">
    <div class="glass-panel account-status-card text-center">
        <div class="account-status-icon danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h1>Verification link unavailable</h1>
        <p>This verification link is invalid, expired, or has already been used.</p>
        <div class="account-status-actions">
            <a asp-controller="Home" asp-action="Index" class="glass-button account-status-action">
                <i class="bi bi-house-door"></i> Back to home
            </a>
            <button type="button" class="glass-button account-status-action" id="verificationRegisterBtn">
                Create account
            </button>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $('#verificationRegisterBtn').on('click', function () {
            window.QuizlyUi?.showModal('#registerModal');
        });
    </script>
}
