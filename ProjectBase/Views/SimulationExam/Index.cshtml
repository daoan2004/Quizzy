@{
    ViewData["Title"] = "Simulation Exam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Practice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/SimulationExam.css" asp-append-version="true" />
}
    <section class="practice-page simulation-page" id="content-grapper">
        <div class="practice-shell glass-panel" id="mainContent" data-aos="fade-up">
            <!--Practice list header-->
            <div class="header-wrapper">
                <div class="flex">
                    <div class="page-name">
                        <h3><i class="bi bi-clipboard2-check"></i> Simulation Exam</h3>
                    </div>
                    <div class="dropdown-bar">
                        <form>
                            <select id="subjectFilter" aria-label="Filter simulation exams by level">
                                <option value="">All Subjects</option>
                                </select>
                        </form>
                    </div>
                    <div class="search-bar">
                        <form>
                            <input type="search" id="nameSearchBox" placeholder="Search by Name..." aria-label="Search simulation exams by name" />
                            <button type="button" id="searchButton"><i class="bi bi-search"></i> Search</button>
                        </form>
                    </div>
                    <div class="Back">
                        <button type="button" class="header-button" onclick="window.history.back()"><i class="bi bi-arrow-left"></i> Back</button>
                    </div>
                </div>
            </div>
            <!--Practice list Table wrapper-->
            <div class="Table-wrapper glass-panel" data-aos="fade-up" data-aos-delay="100">
                <table>

                    <thead class="thead">
                        <tr>
                            <th>ID</th>
                            <th>Subject</th>
                            <th>Simulation Exam</th>
                            <th>Level</th>
                            <th>Question</th>
                            <th>Duration</th>
                            <th>Pass rate</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="simulationExamList" aria-live="polite">
                    </tbody>

                </table>

                <nav id="pagination" aria-label="Simulation exam pages"></nav>
            </div>
        </div>
    </section>
    @section Scripts {
    <script src="~/js/SimulationExam.js" asp-append-version="true"></script>
    }
