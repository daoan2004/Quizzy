@{
    ViewData["Title"] = "BlogDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
@model BlogsViewModel
@{
    var blog = Model.BlogDetail;
    var authorName = Model.BlogUser?.fullname ?? "Quizly Team";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Blogs.css" asp-append-version="true" />
}
    <section class="blog-page blog-detail-page" id="content-grapper">
        <div class="container">
            <!--Blogdetail show start(field1)-->
            <div class="blog-main glass-panel" data-aos="fade-up">
                <div class="DetailHeader" data-aos="fade-up">
                    <h1>@(blog?.title ?? "Blog detail")</h1>
                    <div class="blog-info">
                        <span><i class="bi bi-person"></i> By <a href="#">@authorName</a></span>
                        @if (blog != null)
                        {
                            <span class="last-updated"><i class="bi bi-clock"></i> Last Updated: @blog.updatedAt.Day @blog.updatedAt.Date.ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture) @blog.updatedAt.Year</span>
                        }
                    </div>
                    @if (blog != null)
                    {
                        <img class="header-img" src="~/picture/Carousel/@blog.blog_picture" alt="@blog.title">
                    }
                </div>
                <div class="blog-detail glass-card" data-aos="fade-up">
                    <h5>@(blog?.description ?? "This article is not available.")</h5>
                    <br/>
                    <p>@blog?.body</p>
                </div>
                <div class="category-underdetail">
                    @foreach (var item in Model.BlogCategory)
                    {
                        <span class="under-category">@item.title</span>
                    }
                </div>
            </div>
            <!--Blogdetail end (field1)-->
            <div class="blog-sidebar">
                <!--Category show and search bar(field2)-->
                <div>
                    <div class="sidebar-box blog-sidebar-box" data-aos="fade-left">
                        <partial name="_CategorySideBarPartial" />
                    </div>
                </div>
                <!--Category show and search bar end(field2)-->
                <!--lastest post show start(field 3)-->
                <div>
                    <div class="sidebar-box blog-sidebar-box" data-aos="fade-left" data-aos-delay="100">
                        <partial name="_LatestPostPartial" />
                    </div>
                </div>
                <!--lastest post show end(field 3)-->
            </div>
        </div>
	</section>
    <!--AJAX for showing blog category-->
    @section Scripts {
        <script src="/js/BlogsScript.js"></script>
        <script src="~/js/BlogDetail.js" asp-append-version="true"></script>
    }
