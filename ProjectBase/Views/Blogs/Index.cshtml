@{
    ViewData["Title"] = "Blogs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model BlogsViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/Blogs.css" asp-append-version="true" />
}

<section class="blog-page" id="content-grapper">
    <div class="blog-shell">
        <header class="blog-hero glass-panel" data-aos="fade-up">
            <div>
                <span class="blog-eyebrow"><i class="bi bi-journal-text"></i> Quizly Blog</span>
                <h1>Study notes, quiz tips, and learning updates</h1>
                <p>Read practical posts from the Quizly team and browse topics that help you prepare with more focus.</p>
            </div>
        </header>

        <div class="blog-layout">
            <main class="blog-main glass-panel" data-aos="fade-up">
                <div class="blog-section-heading">
                    <h2>Latest Articles</h2>
                    <span>@Model.BlogList.Count() posts</span>
                </div>

                <div class="blog-list">
                    @foreach (var item in Model.BlogList)
                    {
                        <article class="blog-card glass-card js-tilt-card" data-aos="fade-up">
                            <a class="blog-card-image" asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID">
                                <img src="~/picture/Carousel/@item.blog_picture" alt="@item.title" loading="lazy" decoding="async">
                            </a>

                            <div class="blog-card-body">
                                <div class="blog-card-meta blog-user-meta blog-user-@item.userID" data-user-id="@item.userID"></div>

                                <h3>
                                    <a asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID">@item.title</a>
                                </h3>

                                <p>@item.description</p>

                                <div class="blog-card-footer">
                                    <span class="blog-date"><i class="bi bi-clock"></i> @item.publishAt.ToString("dd/MM/yyyy")</span>
                                    <div id="blog-category-@item.ID" class="blog-category" aria-live="polite"></div>
                                </div>

                                <a class="blog-read-more" asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID">
                                    Read more <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </article>
                    }
                </div>

                <nav class="pagination-container" aria-label="Blog pages">
                    <ul class="pagination"></ul>
                </nav>
            </main>

            <aside class="blog-sidebar">
                <div class="sidebar-box blog-sidebar-box" data-aos="fade-left">
                    <partial name="_CategorySideBarPartial" />
                </div>

                <div class="sidebar-box blog-sidebar-box" data-aos="fade-left" data-aos-delay="100">
                    <partial name="_LatestPostPartial" />
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script src="/js/BlogsScript.js"></script>
    <script src="~/js/BlogIndex.js" asp-append-version="true"></script>
}
