@{
    ViewData["Title"] = "About Quizly";
    ViewData["MetaDescription"] = "Learn about Quizly, a learning platform for browsing subjects, practicing quizzes, and reviewing progress.";
}

<section class="section-shell info-page-shell">
    <div class="info-page-hero glass-panel">
        <p class="info-page-eyebrow"><i class="bi bi-info-circle"></i> About us</p>
        <h1>Quizly keeps learning focused, measurable, and easy to return to.</h1>
        <p>Browse subjects, register for packages, practice with tailored questions, and review your progress from one consistent workspace.</p>
    </div>

    <div class="info-page-grid">
        <article class="info-page-card glass-card">
            <i class="bi bi-journal-check"></i>
            <h2>Practice smarter</h2>
            <p>Create practice sessions by subject, level, topic, and question type.</p>
        </article>
        <article class="info-page-card glass-card">
            <i class="bi bi-clipboard2-check"></i>
            <h2>Review clearly</h2>
            <p>Track attempts, see answers, and understand where to improve next.</p>
        </article>
        <article class="info-page-card glass-card">
            <i class="bi bi-stars"></i>
            <h2>Keep momentum</h2>
            <p>Use featured subjects and learning posts to keep each study session useful.</p>
        </article>
    </div>
</section>
