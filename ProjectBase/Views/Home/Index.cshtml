@{
    ViewData["Title"] = "Home Page";
    ViewData["MetaDescription"] ??= "Quizly helps learners browse subjects, read learning posts, practice quizzes, and review progress.";
}
@model HomeViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/IndexStyle.css" asp-append-version="true" />
}

<div class="home-page-wrapper">
    <section class="home-hero">
        <div class="home-hero-copy">
            <p class="home-eyebrow"><i class="bi bi-stars"></i> Learn faster with Quizly</p>
            <h1>The one and only quiz for you</h1>
            <p>Browse subjects, practice smarter, and review your progress in one smooth place.</p>
            <div class="home-hero-actions">
                <a asp-controller="Subjects" asp-action="Index" id="start_button" class="btn">
                    Get Started <i class="bi bi-arrow-right"></i>
                </a>
                <a asp-controller="Blogs" asp-action="Index" class="home-secondary-link">
                    Read blogs <i class="bi bi-journal-text"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="home-content-grid">
        <div class="home-main-column">
            <div id="Mainslider" class="home-slider swiper js-swiper glass-panel" data-loop="false" data-tablet-slides="1" data-desktop-slides="1">
                <div class="swiper-wrapper">
                    <div class="swiper-slide home-hero-slide">
                        <div class="home-slide-content">
                            <span>Featured</span>
                            <h2>Explore learning stories</h2>
                            <a asp-controller="Blogs" asp-action="Index" class="home-slide-button">Open blogs <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                    @foreach (var item in Model.Sliders)
                    {
                        <div class="swiper-slide home-slider-item">
                            <a asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID" class="home-slide-link">
                                <img src="/picture/Carousel/@item.image" class="home-slide-image" alt="@item.Title" loading="lazy" decoding="async">
                            </a>
                            <div class="home-slide-content">
                                <span>@item.updatedAt.ToString("dd/MM/yyyy")</span>
                                <h2>@item.Title</h2>
                                <p>@item.description</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="swiper-pagination"></div>
                <button class="swiper-button-prev" type="button" aria-label="Previous slide"></button>
                <button class="swiper-button-next" type="button" aria-label="Next slide"></button>
            </div>

            <section class="home-posts glass-panel">
                <div class="home-section-heading">
                    <h2><i class="bi bi-fire"></i> Hot Posts</h2>
                    <a asp-controller="Blogs" asp-action="Index">View all <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="home-post-list">
                    @foreach (var item in Model.BlogView)
                    {
                        <article class="home-post-card glass-card js-tilt-card" data-aos="fade-up">
                            <a asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID" class="home-post-image-link">
                                <img class="home-post-image" src="/picture/Carousel/@item.blog_picture" alt="@item.title" loading="lazy" decoding="async">
                            </a>
                            <div class="home-post-body">
                                <p class="home-post-date">Published: @item.publishAt.ToString("dd/MM/yyyy")</p>
                                <h3><a asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID">@item.title</a></h3>
                                <p>@item.description</p>
                                <a class="home-more-link" asp-action="BlogsDetail" asp-controller="Blogs" asp-route-blogid="@item.ID" asp-route-userid="@item.userID">
                                    Read more <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>

        <aside class="home-sidebar">
            <div class="sidebar-box" data-aos="fade-left">
                <partial name="_LatestPostPartial" />
            </div>
            <div id="featureSubjectPartial" class="sidebar-box" data-aos="fade-left" data-aos-delay="100">
                <partial name="_SubjectFeaturedPartial" />
            </div>
        </aside>
    </section>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('.latestPost-item').each(function () {
                var userId = $(this).find('.post-details').find('.author').data('user-id');
                loadLatestPostInfo(userId);
            });
        });

        function loadLatestPostInfo(userId) {
            if (!userId) {
                return;
            }

            $.ajax({
                url: '/api/BlogApi/GetBlogUser/' + userId,
                type: 'GET',
                success: function (data) {
                    if (!data || !data.length) {
                        return;
                    }

                    var user = data[0];
                    var userHtml = '<i class="bi bi-person"></i> ' + user.fullname;
                    $('.latestPost-item').find('.post-details').find('.author-user-' + userId).html(userHtml);
                },
                error: function () {
                    $('.latestPost-item').find('.post-details').find('.author-user-' + userId).html('<i class="bi bi-person"></i> Quizly');
                }
            });
        }
    </script>
}
