        <div class="modal fade" tabindex="-1" id="profileModal" role="dialog" aria-modal="true" aria-label="User profile" data-bs-keyboard="false" data-bs-backdrop="static">
            <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
                <div class="modal-content auth-modal profile-modal-content">
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close profile dialog">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                    <div class="modal-body">
                        <form id="profileForm" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-md-4 profile-aside">
                                    <div class="form-group d-flex justify-content-center">
                                        <img id="profileAvatar" src="/picture/DropList/user.png" alt="User Avatar" class="profile-avatar" />
                                    </div>
                                    <div class="form-group d-flex justify-content-center">
                                        <label class="visually-hidden" for="profileName">Full name</label>
                                        <input id="profileName" name="fullName" class="form-control" type="text" placeholder="Name" readonly />
                                    </div>
                                    <div class="form-group d-flex justify-content-center">
                                        <label class="visually-hidden" for="profileRole">Account role</label>
                                        <input id="profileRole" name="role" class="form-control" type="text" placeholder="Role" readonly />
                                    </div>
                                    <div class="" id="avatarUpload" style="display: none;">
                                        <input id="avatar" name="avatar" class="form-control-file" type="file" accept="image/*" aria-label="Upload profile picture">
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label class="form-label label-text">Gender:</label>
                                        <div class="genderOptions">
                                            <div class="genderOption">
                                                <input id="profileGenderMale" type="radio" name="gender" value="true" disabled>
                                                <label for="profileGenderMale">Male</label>
                                            </div>
                                            <div class="genderOption">
                                                <input id="profileGenderFemale" type="radio" name="gender" value="false" disabled>
                                                <label for="profileGenderFemale">Female</label>
                                            </div>
                                        </div>                                       
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label label-text" for="address">Address:</label>
                                        <input id="address" name="address" type="text" class="form-control" placeholder="Your address here" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label label-text" for="email">Email:</label>
                                        <input id="email" name="email" type="email" class="form-control" readonly autocomplete="on">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label label-text" for="phoneNumber">Phone number:</label>
                                        <input id="phoneNumber" name="phone" type="text" class="form-control" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label label-text" for="dob">Date of birth:</label>
                                        <input id="dob" name="dob" type="text" class="form-control" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label label-text" for="description">Description:</label>
                                        <textarea id="description" name="description" class="form-control" readonly></textarea>
                                    </div>
                                    <div class="form-group text-center">
                                        <button type="button" id="editProfileBtn" class="btn btn-primary">Edit Profile</button>
                                        <button type="submit" id="updateProfileBtn" class="btn btn-primary" style="display: none;">Update Profile</button>
                                        <div class="alert alert-success mt-3" id="successMessage" role="status" aria-live="polite" style="display: none;">
                                            Profile updated successfully.
                                        </div>
                                        <div class="alert alert-danger mt-3" id="errorMessage" role="alert" aria-live="assertive" style="display: none;">
                                            An error occurred while updating the profile.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <script src="~/js/Profile.js" asp-append-version="true"></script>
    </script>
