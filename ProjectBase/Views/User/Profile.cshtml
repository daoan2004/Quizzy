<div class="modal fade" tabindex="-1" id="profileModal" role="dialog"
     aria-modal="true" aria-labelledby="profileModalTitle"
     data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content profile-modal-content">
            <header class="profile-modal-header">
                <div>
                    <span class="profile-modal-eyebrow">Account settings</span>
                    <h2 id="profileModalTitle">Your profile</h2>
                    <p>Review your personal details and keep your account up to date.</p>
                </div>
                <button type="button" class="modal-close" data-bs-dismiss="modal"
                        aria-label="Close profile dialog">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </header>

            <div class="modal-body profile-modal-body">
                <form id="profileForm" enctype="multipart/form-data">
                    <div class="profile-layout">
                        <aside class="profile-aside">
                            <div class="profile-avatar-frame">
                                <img id="profileAvatar"
                                     src="/picture/DropList/user.png"
                                     alt="User avatar"
                                     class="profile-avatar" />
                                <span class="profile-online-indicator"
                                      aria-label="Account active"></span>
                            </div>

                            <div class="profile-identity">
                                <label class="visually-hidden" for="profileName">Full name</label>
                                <input id="profileName" name="fullName"
                                       class="profile-name-input" type="text"
                                       placeholder="Name" readonly />

                                <label class="visually-hidden" for="profileRole">Account role</label>
                                <div class="profile-role-wrap">
                                    <i class="bi bi-person-check" aria-hidden="true"></i>
                                    <input id="profileRole" name="role"
                                           class="profile-role-input" type="text"
                                           placeholder="Role" readonly />
                                </div>
                            </div>

                            <div id="avatarUpload" class="profile-upload" style="display: none;">
                                <label for="avatar">
                                    <i class="bi bi-camera" aria-hidden="true"></i>
                                    Choose new photo
                                </label>
                                <input id="avatar" name="avatar" type="file"
                                       accept="image/*" aria-label="Upload profile picture">
                            </div>

                            <div class="profile-aside-note">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                <span>Your account information is private.</span>
                            </div>
                        </aside>

                        <section class="profile-details" aria-label="Profile details">
                            <div class="profile-section-heading">
                                <div>
                                    <span>Personal information</span>
                                    <h3>Profile details</h3>
                                </div>
                                <span class="profile-status">
                                    <span aria-hidden="true"></span> Active
                                </span>
                            </div>

                            <fieldset class="profile-fieldset">
                                <legend>Gender</legend>
                                <div class="genderOptions">
                                    <label class="genderOption" for="profileGenderMale">
                                        <input id="profileGenderMale" type="radio"
                                               name="gender" value="true" disabled>
                                        <span><i class="bi bi-person" aria-hidden="true"></i> Male</span>
                                    </label>
                                    <label class="genderOption" for="profileGenderFemale">
                                        <input id="profileGenderFemale" type="radio"
                                               name="gender" value="false" disabled>
                                        <span><i class="bi bi-person" aria-hidden="true"></i> Female</span>
                                    </label>
                                </div>
                            </fieldset>

                            <div class="profile-fields-grid">
                                <div class="profile-field">
                                    <label for="address">Address</label>
                                    <div class="profile-input-wrap">
                                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                        <input id="address" name="address" type="text"
                                               class="form-control"
                                               placeholder="Your address" readonly>
                                    </div>
                                </div>

                                <div class="profile-field">
                                    <label for="phoneNumber">Phone number</label>
                                    <div class="profile-input-wrap">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                        <input id="phoneNumber" name="phone" type="text"
                                               class="form-control" readonly>
                                    </div>
                                </div>

                                <div class="profile-field profile-field-wide">
                                    <label for="email">Email address</label>
                                    <div class="profile-input-wrap">
                                        <i class="bi bi-envelope" aria-hidden="true"></i>
                                        <input id="email" name="email" type="email"
                                               class="form-control" readonly autocomplete="email">
                                        <span class="profile-locked">
                                            <i class="bi bi-lock" aria-hidden="true"></i> Locked
                                        </span>
                                    </div>
                                </div>

                                <div class="profile-field">
                                    <label for="dob">Date of birth</label>
                                    <div class="profile-input-wrap">
                                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                                        <input id="dob" name="dob" type="text"
                                               class="form-control" readonly>
                                    </div>
                                </div>

                                <div class="profile-field profile-field-wide">
                                    <label for="description">About you</label>
                                    <textarea id="description" name="description"
                                              class="form-control"
                                              placeholder="Tell us a little about yourself"
                                              readonly></textarea>
                                </div>
                            </div>

                            <div class="profile-actions">
                                <button type="button" id="editProfileBtn"
                                        class="profile-button profile-button-primary">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    Edit profile
                                </button>
                                <button type="submit" id="updateProfileBtn"
                                        class="profile-button profile-button-primary"
                                        style="display: none;">
                                    <i class="bi bi-check2" aria-hidden="true"></i>
                                    Save changes
                                </button>
                            </div>

                            <div class="alert alert-success" id="successMessage"
                                 role="status" aria-live="polite" style="display: none;">
                                Profile updated successfully.
                            </div>
                            <div class="alert alert-danger" id="errorMessage"
                                 role="alert" aria-live="assertive" style="display: none;">
                                An error occurred while updating the profile.
                            </div>
                        </section>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="~/js/Profile.js" asp-append-version="true"></script>
