@{
    ViewData["Title"] = "ResetPasswordRequest";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ResetPassword.css" asp-append-version="true" />
}
    <div class="container reset-password-container">
        <div class="reset-password-header">
            <h2><i class="bi bi-envelope-lock"></i> Reset Password</h2>
            <div class="titleResetPassword">
                <p>Please enter the email you used to register. We'll send you a link to log in and reset your password.</p>
            </div>           
        </div>
        <div class="reset-password-form">
            <form id="resetPasswordRequestForm" asp-action="ResetPasswordRequest" asp-controller="Account">
                <div class="form-group">
                    <input type="email" class="form-control" name="Email" placeholder="Enter your registered email" aria-label="Registered email address" autocomplete="email" required>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Send confirmation email</button>
                </div>
            </form>
            <div id="resetPasswordMessage" class="mt-3"></div>
        </div>
    </div>
@section Scripts {
        <script>
            $(document).ready(function () {
                $('#resetPasswordRequestForm').submit(function (event) {
                    event.preventDefault(); // Chặn hành động mặc định của form
                    var submitButton = $(this).find('button[type="submit"]');
                    var originalButtonHtml = submitButton.html();
                    submitButton.prop('disabled', true).text('Sending…');
                    $('#resetPasswordMessage').empty();

                    var formData = {
                        email: $('input[name="Email"]').val() // Lấy giá trị từ input email
                    };

                    $.ajax({
                        url: '/Account/ResetPasswordRequest',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(formData), // Chuyển đổi dữ liệu sang JSON
                        success: function (response) {
                            var messageDiv = $('#resetPasswordMessage');
                            if (response.success) {
                                messageDiv.html('<div class="alert alert-success">Password reset email sent.</div>');
                                setTimeout(function () {
                                    window.location.href = '/'; // Chuyển hướng về trang home sau 2 giây
                                }, 2000); // 2 giây
                            } else {
                                messageDiv.empty().append(
                                    $('<div>', { class: 'alert alert-danger' })
                                        .text('Error: ' + (response.message || 'Unable to send request.'))
                                );
                            }
                        },
                        error: function (xhr, status, error) {
                            $('#resetPasswordMessage').empty().append(
                                $('<div>', { class: 'alert alert-danger' })
                                    .text('Error sending reset password request.')
                            );
                        },
                        complete: function () {
                            submitButton.prop('disabled', false).html(originalButtonHtml);
                        }
                    });
                });
            });
        </script>
}
