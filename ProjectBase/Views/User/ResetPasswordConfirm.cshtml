@{
    ViewData["Title"] = "ResetPasswordConfirm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ResetPassword.css" asp-append-version="true" />
}
    <div class="container reset-password-container">
        <div class="reset-password-header">
            <h2><i class="bi bi-shield-lock"></i> Reset Password</h2>
            <div class="titleResetPassword">
                <p>Password requirements: at least one uppercase letter, one lowercase letter, one digit, and one special character.</p>
            </div>
        </div>
        <div class="reset-password-form">
            <form id="resetPasswordConfirmForm">
                <div class="form-group">
                    <input type="password" class="form-control" id="inputPassword" name="NewPassword" placeholder="Enter your new password" aria-label="New password" autocomplete="new-password" required>
                </div>
                <div class="form-group">
                    <input type="password" class="form-control" id="inputConfirmPassword" name="ReNewPassword" placeholder="Re-enter your new password" aria-label="Confirm new password" autocomplete="new-password" required>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Change password</button>
                </div>
                <input type="hidden" id="token" name="Token" value="@ViewBag.Token" /><!-- Input hidden để lưu token -->
            </form>
            <div id="message" class="mt-3"></div>
        </div>
    </div>

@section Scripts {
        <script>
            $(document).ready(function () {
                $('#resetPasswordConfirmForm').submit(function (event) {
                    event.preventDefault();
                    var submitButton = $(this).find('button[type="submit"]');
                    var originalButtonHtml = submitButton.html();
                    submitButton.prop('disabled', true).text('Changing…');
                    var formData = {
                        NewPassword: $('#inputPassword').val(),
                        ReNewPassword: $('#inputConfirmPassword').val(),
                        Token: $('#token').val()
                    };

                    $.ajax({
                        url: '@Url.Action("ResetPasswordConfirm", "Account")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(formData),
                        success: function (response) {
                            var messageDiv = $('#message');
                            messageDiv.removeClass('alert alert-danger alert-success');
                            if (response.success) {
                                messageDiv.addClass('alert alert-success');
                                messageDiv.text(response.message);
                                setTimeout(function () {
                                    window.location.href = '/'; // Redirect to login page or appropriate page after delay
                                }, 2000); // Redirect after 2 seconds (2000 milliseconds)
                            } else {
                                messageDiv.addClass('alert alert-danger');
                                messageDiv.text('Error: ' + response.message);
                                if (response.errors) {
                                    response.errors.forEach(function (error) {
                                        messageDiv.append(document.createElement('br'));
                                        messageDiv.append(document.createTextNode(error));
                                    });
                                }
                            }
                        },
                        error: function () {
                            var messageDiv = $('#message');
                            messageDiv.removeClass('alert alert-success').addClass('alert alert-danger');
                            messageDiv.text('Error resetting password.');
                        },
                        complete: function () {
                            submitButton.prop('disabled', false).html(originalButtonHtml);
                        }
                    });
                });
            });
        </script>
}
