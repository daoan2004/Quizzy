    <div class="container">
        <div class="modal fade" tabindex="-1" id="changePasswordModal" role="dialog" aria-modal="true" aria-label="Change password" data-keyboard="false" data-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content auth-modal">
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close change password dialog">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                    <div id="changePasswordErrorMessage" class="alert alert-danger" role="alert" aria-live="assertive" style="display:none;"></div>
                    <div id="changePasswordSuccessMessage" class="alert alert-success" role="status" aria-live="polite" style="display:none;"></div>
                    <div class="modal-title text-center w-100"><i class="bi bi-shield-lock"></i> Change Password</div>
                    <div class="modal-body">
                        <form id="changePasswordForm" asp-action="ChangePassword" asp-controller="Account">
                            <div class="form-group d-flex justify-content-center">
                                <input class="form-control" type="password" placeholder="Current password" id="currentPassword" autocomplete="current-password" aria-label="Current password" />
                            </div>
                            <div class="form-group d-flex justify-content-center">
                                <input class="form-control" type="password" placeholder="New password" id="newPassword" autocomplete="new-password" aria-label="New password" />
                            </div>
                            <div class="form-group d-flex justify-content-center">
                                <input class="form-control" type="password" placeholder="Confirm new password" id="confirmNewPassword" autocomplete="new-password" aria-label="Confirm new password" />
                            </div>
                            <div class="form-group text-center">
                                <button type="submit" class="btn btn-primary btn-login mb-2" id="changePassword"><i class="bi bi-check2-circle"></i> Change</button>
                            </div>
                            
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/ChangePassword.js" asp-append-version="true"></script>

